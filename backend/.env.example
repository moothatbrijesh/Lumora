# Optional: the server uses 3000 by default.
PORT=3000

# Local Docker Compose credentials only. Never use these for a deployed database.
DATABASE_URL=postgresql://lumora:lumora_local_only@127.0.0.1:5432/lumora
TEST_DATABASE_URL=postgresql://lumora:lumora_test_only@127.0.0.1:5433/lumora_test
# Enable fictional sample data only in your local development environment.
ALLOW_DEMO_SEED=true
# Browser origins only; native apps do not send an Origin header.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Backend only. Enter a real key securely in environment settings (or local .env).
LUMORA_OPENAI_API_KEY=
LUMORA_OPENAI_MODEL=gpt-4.1-mini
